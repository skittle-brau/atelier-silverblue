{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "ghcr.io/skittle-brau/atelier-silverblue": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/atelier-silverblue.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "registry.fedoraproject.org": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        }
    }
}
